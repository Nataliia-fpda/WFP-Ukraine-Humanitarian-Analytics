table 2022-2025
	lineageTag: e9f36f32-2470-433b-bd99-00d3c7680462

	measure 'Number of Beneficiaries' = CALCULATE(SUM('2022-2025'[Value]),'2022-2025'[Units]="Persons")
		formatString: #,0
		lineageTag: cd33cfbe-b055-4d41-b5ac-29429e002155

	measure 'Cash Based Transfers' = CALCULATE(SUM('2022-2025'[Value]),'2022-2025'[Units]="USD")
		formatString: #,0
		lineageTag: 9f5e1469-8309-4b74-9ad9-bccc8060e748

	measure Plan = CALCULATE(SUM('2022-2025'[Value]),'2022-2025'[Budget Attribute]="Planned")
		formatString: #,0
		lineageTag: 7b1d0308-6343-40f5-bb27-45640f7a4b2a

	measure Actual = CALCULATE(SUM('2022-2025'[Value]),'2022-2025'[Budget Attribute]="Actual")
		formatString: #,0
		lineageTag: 4825735a-0439-4128-b96d-0def7e31d96c

	measure 'Deviation_Benef.' = CALCULATE([Actual] - [Plan],'2022-2025'[Units]="Persons")
		formatString: #,0
		isHidden
		lineageTag: f3a9bf13-91eb-4b6b-9455-2b1054077bfa

		changedProperty = IsHidden

	measure 'Plan Execution Benefeciaries %' = CALCULATE(DIVIDE([Actual], [Plan], 0),'2022-2025'[Units]="Persons")
		formatString: 0%;-0%;0%
		lineageTag: b984379e-19be-42e4-8322-8dadff618a48

	measure Deviation_Cash = CALCULATE([Actual] - [Plan],'2022-2025'[Units]="USD")
		formatString: #,0
		lineageTag: 8d8941b6-9417-443c-8a5f-d56fe4ff58a7

	measure 'Plan Execution Cash %' = CALCULATE(DIVIDE([Actual], [Plan], 0),'2022-2025'[Units]="USD")
		formatString: 0%;-0%;0%
		lineageTag: 49859e0a-7a86-4ea9-b3a1-ad63409b510e

	measure 'Deviation from Plan' = [Actual] - [Plan]
		formatString: #,0
		lineageTag: 0ecff423-115f-4bfc-9ba5-26c09c4486a2

	measure 'Plan Execution, %' = DIVIDE([Actual], [Plan], 0)
		formatString: 0%;-0%;0%
		lineageTag: f9d055c6-d7af-4452-b533-eb6220cabba1

	measure 'Actual Previous Year' =
			
			VAR CurrentYear = MAX(DimYear[Year])
			RETURN
			    CALCULATE([Actual],FILTER(ALL(DimYear[Year]),DimYear[Year] = CurrentYear - 1))
		formatString: #,0
		lineageTag: bb918d10-a58a-40c6-8b2c-ce1513c8ce1d

	measure 'Actual YoY %' =
			
			DIVIDE([Actual] - [Actual Previous Year],[Actual Previous Year])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 363685e8-3156-41d7-8d22-64ad9c3a7d4c

