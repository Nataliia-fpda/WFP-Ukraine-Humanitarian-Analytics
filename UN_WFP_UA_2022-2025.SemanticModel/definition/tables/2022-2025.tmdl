	partition 2022-2025 = m
		mode: import
		source =
				let
				    Source = Table.Combine({#"CBT_2022-2025", #"Gender_Age_2022-2025"}),
				    #"Reordered Columns" = Table.ReorderColumns(Source,{"Category", "Strategic_Outcome", "Modality", "Gender", "Age", "Units", "Year", "Planned_Actual", "Value"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Reordered Columns",{{"Value", Int64.Type}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"Planned_Actual", "Budget Attribute"}})
